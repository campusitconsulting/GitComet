{
  "schema_version": 2,
  "name": "SourceTree Familiar",
  "author": "GitComet downstream",
  "themes": [
    {
      "key": "sourcetree_familiar_light",
      "name": "SourceTree Familiar Light",
      "appearance": "light",
      "colors": {
        "surface": {
          "canvas": "#ffffffff",
          "chrome": "#eef1f2ff",
          "panel": "#e2e4e5ff",
          "raised": "#f6f7f7ff",
          "input": "#ffffffff"
        },
        "foreground": {
          "primary": "#252627ff",
          "secondary": "#5f6467ff",
          "disabled": { "hex": "#5f6467ff", "alpha": 0.56 },
          "placeholder": "#25262770",
          "emphasis": "#111213ff"
        },
        "stroke": {
          "subtle": "#25262718",
          "default": "#c5c9cbff",
          "control": "#858b8fff"
        },
        "interaction": {
          "hover_overlay": { "hex": "#252627ff", "alpha": 0.06 },
          "pressed_overlay": { "hex": "#252627ff", "alpha": 0.10 },
          "hover_background": "#d9dcdeff",
          "pressed_background": "#cbd0d2ff",
          "selected_background": "#2962d9ff",
          "selected_foreground": "#ffffffff",
          "selected_indicator": "#111213ff",
          "focus_ring": "#2962d9ff",
          "focus_background": { "hex": "#2962d9ff", "alpha": 0.15 }
        },
        "accent": {
          "foreground": "#2962d9ff",
          "solid": "#2962d9ff",
          "on_solid": "#ffffffff",
          "subtle_background": "#e4f1fdff"
        },
        "status": {
          "info": { "foreground": "#2962d9ff", "background": "#e4f1fdff", "border": "#557abdff" },
          "success": { "foreground": "#287a4bff", "background": "#ddfceeff", "border": "#4d8a5aff" },
          "warning": { "foreground": "#725007ff", "background": "#fff0bdff", "border": "#96701eff" },
          "danger": { "foreground": "#b04b3fff", "background": "#ffe8e3ff", "border": "#b45a5cff" }
        },
        "editor": {
          "background": "#ffffffff",
          "foreground": "#252627ff",
          "gutter_background": "#f6f7f7ff",
          "line_number": "#8a8f92ff",
          "cursor": "#2962d9ff",
          "selection_background": "#cfe6fcff",
          "search_match_background": "#fff0bdff",
          "search_match_foreground": "#725007ff",
          "bracket_match_background": "#e4f1fdff",
          "indent_guide": "#d8dbddff"
        },
        "diff": {
          "added": {
            "foreground": "#1d6728ff",
            "background": "#e4f3e7ff",
            "word_background": "#d9efdcff",
            "focused_background": "#cdebd3ff"
          },
          "removed": {
            "foreground": "#a52a35ff",
            "background": "#fce8eaff",
            "word_background": "#fae4e6ff",
            "focused_background": "#f7d2d6ff"
          },
          "modified": {
            "foreground": "#725007ff",
            "background": "#fff3d6ff",
            "word_background": "#f8e7baff",
            "focused_background": "#f3dca2ff"
          }
        },
        "tooltip": {
          "background": "#ffffffff",
          "foreground": "#252627ff"
        },
        "scrollbar": {
          "thumb": { "hex": "#5f6467ff", "alpha": 0.34 },
          "thumb_hover": { "hex": "#5f6467ff", "alpha": 0.48 },
          "thumb_pressed": { "hex": "#5f6467ff", "alpha": 0.62 }
        },
        "shadow": "#252627ff"
      },
      "syntax": {
        "comment": "#4b556aff",
        "comment_doc": "#4b556aff",
        "string": "#455c0eff",
        "string_escape": "#455c0eff",
        "string_regex": "#455c0eff",
        "string_special": "#455c0eff",
        "keyword": "#7f470cff",
        "keyword_control": "#7f470cff",
        "preproc": "#5745a7ff",
        "number": "#814431ff",
        "boolean": "#814431ff",
        "function": "#005b80ff",
        "function_method": "#005b80ff",
        "function_special": "#005b80ff",
        "constructor": "#005b80ff",
        "type": "#455c0eff",
        "type_builtin": "#455c0eff",
        "type_interface": "#455c0eff",
        "namespace": "#005b80ff",
        "variable": "#252627ff",
        "variable_parameter": "#252627ff",
        "variable_special": "#252627ff",
        "variable_builtin": "#005b80ff",
        "property": "#005b80ff",
        "label": "#005b80ff",
        "constant": "#7c4261ff",
        "constant_builtin": "#7c4261ff",
        "operator": "#49556bff",
        "punctuation": "#49556bff",
        "punctuation_bracket": "#49556bff",
        "punctuation_delimiter": "#49556bff",
        "punctuation_special": "#49556bff",
        "punctuation_list_marker": "#49556bff",
        "tag": "#455c0eff",
        "attribute": "#005b80ff",
        "markup_heading": "#005b80ff",
        "markup_link": "#005b80ff",
        "text_literal": "#455c0eff",
        "diff_plus": "#1a6225ff",
        "diff_minus": "#a3212dff",
        "diff_delta": "#005b80ff",
        "lifetime": "#005b80ff"
      },
      "radii": {
        "panel": 4.0,
        "pill": 4.0,
        "row": 3.0,
        "control": 4.0,
        "popover": 6.0,
        "window": 10.0
      }
    }
  ]
}
